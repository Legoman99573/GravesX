<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Root parent: the groupId and version defined here are inherited by server/, proxy/ and dist/,
         so the server plugin and the proxy plugins can never be built with different versions. -->
    <groupId>com.ranull</groupId>
    <artifactId>graves-parent</artifactId>
    <version>${revision}${changelist}</version>
    <packaging>pom</packaging>
    <name>GravesX-Parent</name>

    <modules>
        <module>common</module>
        <module>server</module>
        <module>proxy</module>
        <module>dist</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Java level for every module (server, proxy, dist): change it here only.
             The Jenkinsfile's jdk tool must be at least this version. -->
        <java.version>17</java.version>

        <!-- THE version of everything: change it here only. -->
        <build.revision>2026.4.9.4</build.revision>
        <build.suffix>-self</build.suffix>

        <!-- Libby is global: server and proxy use this one version and this one relocation target,
             so the universal jar contains a single copy. build-libs.sh installs the jar for this version. -->
        <libby.version>2.0.1-graves2</libby.version>
        <libby.relocation>com.ranull.graves.bundledlibraries.libby</libby.relocation>

        <!-- Maven CI-friendly version properties (required for the ${revision}${changelist} parent references) -->
        <revision>${build.revision}</revision>
        <changelist>${build.suffix}</changelist>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.alessiodp</groupId>
                <artifactId>libby</artifactId>
                <version>${libby.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- Writes resolved poms so installed/deployed poms never contain ${revision}. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.6.0</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals><goal>flatten</goal></goals>
                    </execution>
                    <execution>
                        <id>flatten-clean</id>
                        <phase>clean</phase>
                        <goals><goal>clean</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Auto-enabled on Jenkins when BUILD_NUMBER exists. -->
        <profile>
            <id>jenkins-dev</id>
            <activation>
                <property>
                    <name>env.BUILD_NUMBER</name>
                </property>
            </activation>
            <properties>
                <build.suffix>-build${env.BUILD_NUMBER}</build.suffix>
            </properties>
        </profile>

        <!-- Clean production release. No -self and no -build###. -->
        <profile>
            <id>release</id>
            <properties>
                <build.suffix></build.suffix>
            </properties>
        </profile>
    </profiles>
</project>

  <build>
    <defaultGoal>clean package</defaultGoal>
    <resources>
      <resource>
        <filtering>true</filtering>
        <directory>src/main/resources</directory>
      </resource>
    </resources>
    <finalName>${project.name}-${project.version}</finalName>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.0</version>
        <configuration>
          <source>${java.version}</source>
          <target>${java.version}</target>
          <encoding>${project.build.sourceEncoding}</encoding>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>shade-main-bundled-only</id>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <shadedArtifactAttached>false</shadedArtifactAttached>
              <createDependencyReducedPom>true</createDependencyReducedPom>
              <artifactSet>
                <includes>
                  <include>com.alessiodp:libby</include>
                  <include>com.github.Anon8281:UniversalScheduler</include>
                  <include>com.github.imDaniX:MiniTranslator</include>
                  <include>com.tchristofferson:ConfigUpdater</include>
                </includes>
              </artifactSet>
              <relocations>
                <relocation>
                  <pattern>com.alessiodp.libby</pattern>
                  <shadedPattern>com.ranull.graves.bundledlibraries.libby</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>com.github.Anon8281.universalScheduler</pattern>
                  <shadedPattern>com.ranull.graves.bundledlibraries.universalScheduler</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>me.imdanix.text</pattern>
                  <shadedPattern>com.ranull.graves.bundledlibraries.imdanix.text</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>com.tchristofferson.configupdater</pattern>
                  <shadedPattern>com.ranull.graves.bundledlibraries.configupdater</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>org.bstats</pattern>
                  <shadedPattern>com.ranull.graves.libraries.bstats</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>com.github.puregero.multilib</pattern>
                  <shadedPattern>com.ranull.graves.libraries.multilib</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>com.zaxxer.hikari</pattern>
                  <shadedPattern>com.ranull.graves.libraries.hikari</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>de.themoep.minedown</pattern>
                  <shadedPattern>com.ranull.graves.libraries.minedown</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>net.kyori</pattern>
                  <shadedPattern>com.ranull.graves.libraries.kyori</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>org.h2</pattern>
                  <shadedPattern>com.ranull.graves.libraries.h2</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>com.mysql</pattern>
                  <shadedPattern>com.ranull.graves.libraries.mysql</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>org.postgresql</pattern>
                  <shadedPattern>com.ranull.graves.libraries.postgresql</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>org.mariadb</pattern>
                  <shadedPattern>com.ranull.graves.libraries.mariadb</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>org.apache.commons.text</pattern>
                  <shadedPattern>com.ranull.graves.libraries.commonstext</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>com.microsoft</pattern>
                  <shadedPattern>com.ranull.graves.libraries.microsoft</shadedPattern>
                </relocation>
              </relocations>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/**</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer />
              </transformers>
              <minimizeJar>false</minimizeJar>
            </configuration>
          </execution>
          <execution>
            <id>shade-api-everything</id>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>api</shadedClassifierName>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <relocations>
                <relocation>
                  <pattern>com.alessiodp.libby</pattern>
                  <shadedPattern>com.ranull.graves.bundledlibraries.libby</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>com.github.Anon8281.universalScheduler</pattern>
                  <shadedPattern>com.ranull.graves.bundledlibraries.universalScheduler</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>me.imdanix.text</pattern>
                  <shadedPattern>com.ranull.graves.bundledlibraries.imdanix.text</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>com.tchristofferson.configupdater</pattern>
                  <shadedPattern>com.ranull.graves.bundledlibraries.configupdater</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>org.bstats</pattern>
                  <shadedPattern>com.ranull.graves.libraries.bstats</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>com.github.puregero.multilib</pattern>
                  <shadedPattern>com.ranull.graves.libraries.multilib</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>com.zaxxer.hikari</pattern>
                  <shadedPattern>com.ranull.graves.libraries.hikari</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>de.themoep.minedown</pattern>
                  <shadedPattern>com.ranull.graves.libraries.minedown</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>net.kyori</pattern>
                  <shadedPattern>com.ranull.graves.libraries.kyori</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>org.h2</pattern>
                  <shadedPattern>com.ranull.graves.libraries.h2</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>com.mysql</pattern>
                  <shadedPattern>com.ranull.graves.libraries.mysql</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>org.postgresql</pattern>
                  <shadedPattern>com.ranull.graves.libraries.postgresql</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>org.mariadb</pattern>
                  <shadedPattern>com.ranull.graves.libraries.mariadb</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>org.apache.commons.text</pattern>
                  <shadedPattern>com.ranull.graves.libraries.commonstext</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>com.microsoft</pattern>
                  <shadedPattern>com.ranull.graves.libraries.microsoft</shadedPattern>
                </relocation>
              </relocations>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>org/slf4j/**</exclude>
                    <exclude>org/jspecify/**</exclude>
                    <exclude>com/google/**</exclude>
                    <exclude>config/**</exclude>
                    <exclude>data/**</exclude>
                    <exclude>google/**</exclude>
                    <exclude>plugin.yml</exclude>
                    <exclude>mariadb.properties</exclude>
                    <exclude>driver.properties</exclude>
                    <exclude>deprecated.properties</exclude>
                    <exclude>INFO_BIN</exclude>
                    <exclude>INFO_SRC</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer />
              </transformers>
              <minimizeJar>true</minimizeJar>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.2.0</version>
        <executions>
          <execution>
            <id>copy-api-jar-name</id>
            <phase>package</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <copy />
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
        <configuration>
          <encoding>${project.build.sourceEncoding}</encoding>
          <nonFilteredFileExtensions>
            <nonFilteredFileExtension>schem</nonFilteredFileExtension>
          </nonFilteredFileExtensions>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>3.12.0</version>
        <executions>
          <execution>
            <id>attach-javadocs</id>
            <goals>
              <goal>jar</goal>
            </goals>
            <configuration>
              <classifier>api-javadoc</classifier>
              <sourcepath>${project.build.sourceDirectory}</sourcepath>
              <excludePackageNames>config,data,
                                com.ranull.graves.libraries.*,
                                com.ranull.graves.bundledlibraries.*</excludePackageNames>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-source-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>attach-sources</id>
            <phase>package</phase>
            <goals>
              <goal>jar-no-fork</goal>
            </goals>
            <configuration>
              <classifier>api-sources</classifier>
              <includes>
                <include>**/*.java</include>
              </includes>
              <excludes>
                <exclude>com/ranull/graves/libraries/**</exclude>
                <exclude>com/ranull/graves/bundledlibraries/**</exclude>
                <exclude>**/*.yml</exclude>
                <exclude>**/*.json</exclude>
                <exclude>config/**</exclude>
                <exclude>data/**</exclude>
              </excludes>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-site-plugin</artifactId>
        <version>4.0.0-M16</version>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.3.1</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
